<?xml version="1.0" ?>
<launch>

    <!-- GENERAL ARGUMENTS & PARAMETERS -->
    <arg name="robot_name" default="panda"/>
    <arg name="tool_name" default="marker3D"/>
    <arg name="simulation" default="true"/>
    <arg name="safety_distance" default="0.03"/>

    <!-- SAMPLING PARAMETERS --> 
    <arg name="sampling_parameters_file" default="$(find robot_arm_calibration)/config/sampling/naive_sampling.yaml"/>
    <rosparam command="load" file="$(arg sampling_parameters_file)"/>

    <param name="sampledConfigurationsStorageFolder" value="$(find robot_arm_calibration)/config/calibratedModels/$(arg robot_name)_$(arg tool_name)/"/> <!-- The rest of the path will be generated automatically depending on sampling parameters -->

    <!-- ROBOT SETUP -->
    <include file="$(find robot_arm_tools)/launch/Setup_$(arg robot_name).launch">
        <arg name="simulation" value="$(arg simulation)"/>
        <arg name="tool_name" value="$(arg tool_name)" />
        <arg name="safety_distance" value="$(arg safety_distance)"/>
        <arg name="planner_name" value="RRTConnect"/>
    </include>

    <!-- MAIN NODE -->
    <node pkg="robot_arm_calibration" type="robot_arm_calibration_sampling_node" name="robot_arm_calibration_sampling_node" output="screen" required="true"/>

    <!-- COLLISIONS --> 
    <node pkg="robot_arm_tools" type="robot_arm_tools_environment_node" name="robot_arm_tools_environment_node" output="screen">
        <param name="environmentFileName" value="$(find robot_arm_calibration)/config/environments/Calibration_$(arg robot_name).yaml"/>
    </node>
    <!--<node type="rviz" name="rviz" pkg="rviz" args="-d $(find robot_arm_calibration)/config/RViz/CalibrationSetup.rviz"/>-->

</launch>
