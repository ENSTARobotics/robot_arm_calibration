<?xml version="1.0" ?>
<launch>

    <arg name="tool_name" default=""/>

    <arg name="topic_base_name" value="mocap_node"/>
    <param name="topicBaseName" value="$(arg topic_base_name)"/>

    <node pkg="mocap_optitrack" type="mocap_node" name="$(arg topic_base_name)">
        <rosparam file="$(find robot_arm_calibration)/config/optitrack_parameters.yaml" command="load" />
    </node>

    <remap from="/robotBasePointsNumber" to="/mocap_node/rigid_bodies/0/marker_set_size"/>

    <remap from="/markerPointsNumber" to="/mocap_node/rigid_bodies/1/marker_set_size" if="$(eval arg('tool_name') == 'marker2D')"/>
    <remap from="/markerPointsNumber" to="/mocap_node/rigid_bodies/2/marker_set_size" if="$(eval arg('tool_name') == 'marker3D')"/>  

    <!-- ROBOT POSITION MEASUREMENT SERVER -->
    <param name="measurementServerName" value="/robot_position_measurement_server"/>
    <param name="measurementServerStorageFolder" value="$(eval eval('_' + '_import_' + '_(\'os\')').path.dirname(arg('target_configurations_file')) + '/measurements/')"/>
    <param name="measurementServerDisplay" value="true"/>
    <node pkg="robot_arm_calibration" type="robot_position_measurement_server" name="robot_position_measurement_server" output="screen"/>
    
</launch>