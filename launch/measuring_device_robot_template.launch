<?xml version="1.0" ?>
<launch>

    <!-- TO BE ADAPTED DEPENDING ON THE MEASURING TOOL -->
    <!-- Positions are sent as a geometry_msgs::PointStamped message-->
    <!-- Joint state is sent as a sensor_msgs::JointState message-->
    <!-- Wrench is sent as a geometry_msgs::WrenchStamped message-->

    <arg name="robot_base_points_topics" default="[]"/>
    <arg name="robot_end_effector_points_topics" default="[]"/>

    <arg name="robot_joint_state_topic" default=""/>
    <arg name="robot_joint_state_data" default="[position]"/>
    <arg name="robot_wrench_topic" value=""/>

    <param name="robotBasePointsTopics" type="yaml" value="$(arg robot_base_points_topics)"/>
    <param name="robotEndEffectorPointsTopics" type="yaml" value="$(arg robot_end_effector_points_topics)"/>
    <param name="robotJointStateTopic" value="$(arg robot_joint_state_topic)"/>
    <param name="robotJointStateData" type="yaml" value="$(arg robot_joint_state_data)"/>
    <param name="robotWrenchTopic" value="$(arg robot_wrench_topic)"/>

    <node pkg="measuring_device_package" type="measuring_device_node" name="measuring_device_node_name" respawn="true" required="true">
        <rosparam file="optional_configuration_file.yaml" command="load" />
    </node>
    
</launch>